{
  "manifest_version": 3,
  "name": "CoolHeaded",
  "version": "0.1.1",
  "description": "A pause between the impulse and the page. You set the terms while calm; they hold when you aren't.",
  "browser_specific_settings": {
    "gecko": {
      "id": "threshold@shanaboxer.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "webNavigation",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "CoolHeaded",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}